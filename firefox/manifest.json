{
  "manifest_version": 3,
  "name": "Scrambilini",
  "version": "1.7.0",
  "description": "Gives every tab a different browser fingerprint. Same tab stays coherent, new tab gets a new identity.",
  "browser_specific_settings": {
    "gecko": {
      "id": "scrambilini@include.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": [
      "src/shared/browser.js",
      "src/shared/profile.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/browser.js",
        "src/shared/profile.js",
        "src/content/scramble.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Scrambilini",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
